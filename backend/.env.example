# 复制为 .env 后填入真实值；.env 已被 gitignore，严禁提交
YHSG_API_TOKEN=dev-single-user-token
# JWT 签名密钥：生产环境必须改成随机长字符串（python -c "import secrets; print(secrets.token_hex(32))"）
YHSG_JWT_SECRET=dev-jwt-secret-change-in-prod
# 种子账号 dev 的初始密码（H5 登录用）
YHSG_BOOTSTRAP_PASSWORD=yhsg123456
YHSG_DATABASE_URL=mysql+pymysql://yhsg:yhsg_dev_2026@localhost:3306/yhsg?charset=utf8mb4
YHSG_REDIS_URL=redis://localhost:6379/0

# ========= 方案 A：本地 Ollama（免 Key、离线、免费，开发默认） =========
# 安装 Ollama 后：ollama pull qwen2.5:3b && ollama pull nomic-embed-text
YHSG_LLM_BASE_URL=http://127.0.0.1:11434/v1
YHSG_LLM_API_KEY=
YHSG_LLM_MODEL=qwen2.5:3b
YHSG_EMBEDDING_MODEL=nomic-embed-text

# ========= 方案 B：阿里云百炼 DashScope（质量最佳，评测/结题用） =========
# https://bailian.console.aliyun.com/ 开通后填 Key，并注释掉上面方案 A 的 BASE_URL
# YHSG_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# YHSG_LLM_API_KEY=sk-xxx
# YHSG_LLM_MODEL=qwen-plus
# YHSG_EMBEDDING_MODEL=text-embedding-v3

# B 站登录态（字幕接口需要），从浏览器 Cookie 中取 SESSDATA
YHSG_BILIBILI_SESSDATA=

# 语义建边阈值
YHSG_SIMILARITY_THRESHOLD=0.75
